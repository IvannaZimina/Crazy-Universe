<Window x:Class="CrazyUniverse.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crazy Zoo" Height="750" Width="1100"
        WindowStartupLocation="CenterScreen" Background="#F4F6F9">

    <!-- ========================================== -->
    <!-- STYLES & RESOURCES                         -->
    <!-- ========================================== -->
    <Window.Resources>
        <!-- Boolean to Visibility converter for dynamic abilities indicators -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#CCCCCC" Direction="270" ShadowDepth="2" BlurRadius="8" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="4"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1D4ED8" TargetName="border"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#E2E8F0" TargetName="border"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FeedButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#10B981"/>
        </Style>

        <Style x:Key="SpecialActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#8B5CF6"/>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#EF4444"/>
        </Style>
    </Window.Resources>

    <!-- ========================================== -->
    <!-- MAIN LAYOUT                                -->
    <!-- ========================================== -->
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="140"/>
        </Grid.RowDefinitions>

        <!-- TOP HEADER BAR -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12" Padding="15,10">
            <Grid>
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="🐾 Crazy Zoo" FontSize="22" FontWeight="Bold" Foreground="#1E293B"/>
                    <TextBlock Text="Different animals. Same crazy world." FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Bind population counter to ZooPopulation property -->
                <Border Background="#E0F2FE" CornerRadius="15" Padding="12,6" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ZooPopulation, StringFormat='Zoo Population: {0}'}" Foreground="#0369A1" FontWeight="SemiBold" FontSize="12"/>
                </Border>
            </Grid>
        </Border>

        <!-- 3-COLUMN CONTENT AREA (Row 1) - Rebalanced widths: Left (280), Center (*), Right (280) -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Enclosures Accordion List -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,6,0" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Section Title -->
                    <TextBlock Text="Enclosures" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="4,0,0,8"/>

                    <!-- Accordion view of Enclosures using ItemsControl with Expander -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Enclosures}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Expander is set to be expanded by default on startup -->
                                    <Expander Header="{Binding DisplayName}" IsExpanded="True" Margin="0,0,0,6">
                                        <Grid Margin="0,4,0,4">
                                            <!-- ListBox with animals (visible when Animals.Count > 0) -->
                                            <ListBox ItemsSource="{Binding Animals}"
                                                     SelectedItem="{Binding DataContext.SelectedAnimal, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                                     Background="Transparent" BorderBrush="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.Style>
                                                    <Style TargetType="ListBox">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Animals.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ListBox.Style>
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                        <Setter Property="Margin" Value="0,0,0,4"/>
                                                        <Setter Property="Padding" Value="0"/>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <!-- Compact Row Design with MouseBinding to SelectAnimalCommand -->
                                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                                            <Border.InputBindings>
                                                                <MouseBinding MouseAction="LeftClick" 
                                                                              Command="{Binding DataContext.SelectAnimalCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                              CommandParameter="{Binding}"/>
                                                            </Border.InputBindings>
                                                            <StackPanel>
                                                                <Grid>
                                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="#1E293B"/>
                                                                    <TextBlock Text="{Binding TypeName}" HorizontalAlignment="Right" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                                                                </Grid>
                                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                                                                    <ProgressBar Value="{Binding Satiety, Mode=OneWay}" Minimum="0" Maximum="100" Width="120" Height="5" Foreground="#10B981" Background="#E2E8F0"/>
                                                                    <TextBlock Text="{Binding Satiety, StringFormat={}{0}%}" FontSize="10" Foreground="#64748B" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>

                                            <!-- Placeholder text (visible when Animals.Count == 0) -->
                                            <TextBlock Text="Пока здесь никто не живет 🐾" 
                                                       FontStyle="Italic" FontSize="11" Foreground="#94A3B8" 
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Animals.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Bind total animals counter to TotalAnimalsCount property -->
                    <TextBlock Grid.Row="2" Text="{Binding TotalAnimalsCount, StringFormat='Total animals: {0}'}" FontSize="11" Foreground="#64748B" Margin="4,8,0,0"/>
                </Grid>
            </Border>

            <!-- CENTER COLUMN: Detailed Information Card -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="6,0,6,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <!-- Set DataContext to currently selected animal -->
                    <StackPanel DataContext="{Binding SelectedAnimal}">

                        <!-- Header inside Card -->
                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,10,0"/>
                                <Border Background="#E0F2FE" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TypeName}" Foreground="#0369A1" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding Id, StringFormat=ID: {0}}" FontSize="11" Foreground="#64748B" Margin="0,0,0,10"/>

                        <!-- Satiety Progress Bar -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="❤ Satiety:" FontWeight="Bold" Width="80" Foreground="#475569" VerticalAlignment="Center"/>
                            <ProgressBar Value="{Binding Satiety, Mode=OneWay}" Minimum="0" Maximum="100" Width="180" Height="10" Foreground="#10B981" Background="#E2E8F0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Satiety, StringFormat={}{0}%}" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Dynamic Abilities Status Indicators -->
                        <StackPanel x:Name="AbilitiesPanel" Margin="0,0,0,15">
                            <TextBlock Text="Abilities &amp; Features:" FontSize="13" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,5"/>

                            <!-- Bound visibility to ViewModel properties using BoolToVis converter -->
                            <TextBlock Text="🌊 Can Swim (ISwimmable)" FontSize="12" Foreground="#3B82F6" Margin="0,2" 
                                       Visibility="{Binding DataContext.CanSelectedAnimalSwim, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>

                            <TextBlock Text="🦘 Can Jump (IJumpable)" FontSize="12" Foreground="#3B82F6" Margin="0,2" 
                                       Visibility="{Binding DataContext.CanSelectedAnimalJump, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>

                            <TextBlock Text="🔊 Can Make Sounds (IVocalizable)" FontSize="12" Foreground="#3B82F6" Margin="0,2" 
                                       Visibility="{Binding DataContext.CanSelectedAnimalMakeSound, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>

                        <Separator Margin="0,5,0,12" Background="#E2E8F0"/>

                        <TextBlock Text="Information" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8"/>

                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Name:" FontWeight="Bold" Width="110" Foreground="#475569"/>
                            <TextBlock Text="{Binding Name}" FontSize="13" Foreground="#1E293B"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Species:" FontWeight="Bold" Width="110" Foreground="#475569"/>
                            <TextBlock Text="{Binding TypeName}" FontSize="13" Foreground="#1E293B"/>
                        </StackPanel>

                        <Separator Margin="0,10" Background="#E2E8F0"/>

                        <TextBlock Text="Description" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="#64748B" FontSize="12" LineHeight="18" Margin="0,0,0,10"/>

                        <TextBlock Text="Behavioral Features" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,6"/>
                        <TextBlock Text="Satiety directly affects animal behavior. Performing crazy actions consumes energy. If satiety drops below 20%, the animal gets exhausted and starts acting totally weird!" 
                                   TextWrapping="Wrap" Foreground="#64748B" FontSize="12" LineHeight="18"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- RIGHT COLUMN: Actions Panel -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Margin="6,0,0,0" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Actions" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>

                    <!-- Actions Panel Buttons with Commands and Dynamic Texts -->
                    <Button x:Name="BtnFeed" Content="Feed (+5)" Style="{StaticResource FeedButtonStyle}" Command="{Binding FeedCommand}" Margin="0,3"/>

                    <Button x:Name="BtnSwim" Content="{Binding SwimButtonText}" Style="{StaticResource ActionButtonStyle}" Command="{Binding SwimCommand}" Margin="0,3"/>
                    <Button x:Name="BtnJump" Content="{Binding JumpButtonText}" Style="{StaticResource ActionButtonStyle}" Command="{Binding JumpCommand}" Margin="0,3"/>
                    <Button x:Name="BtnMakeSound" Content="{Binding MakeSoundButtonText}" Style="{StaticResource ActionButtonStyle}" Command="{Binding MakeSoundCommand}" Margin="0,3"/>

                    <Button Content="Crazy Action" Style="{StaticResource SpecialActionButtonStyle}" Command="{Binding CrazyActionCommand}" Margin="0,3"/>

                    <Separator Margin="0,8" Background="#E2E8F0"/>

                    <!-- Management Buttons Group (+ Add Animal moved above Remove Animal) -->
                    <Button Content="+ Add Animal" Style="{StaticResource ActionButtonStyle}" Command="{Binding AddAnimalCommand}" Margin="0,3"/>
                    <Button Content="Remove Animal" Style="{StaticResource DangerButtonStyle}" Command="{Binding RemoveAnimalCommand}" Margin="0,3"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- BOTTOM FULL-WIDTH ROW: Event Log (Row 2) -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Event Log" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,6"/>

                <!-- Bind ItemsControl to LogMessages collection -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding LogMessages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="11" Foreground="#334155" Margin="0,1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>