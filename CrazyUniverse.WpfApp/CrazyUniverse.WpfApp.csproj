<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <None Remove="Images\dolphin.jpg" />
    <None Remove="Images\frog.jpg" />
    <None Remove="Images\honeybadger.jpg" />
    <None Remove="Images\kangaroo.jpg" />
    <None Remove="Images\Lions_migration.jpg" />
    <None Remove="Images\Monkyes_jump.JPG" />
    <None Remove="Images\penguin_jump.JPG" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CrazyUniverse.Core\CrazyUniverse.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Images\dolphin.jpg">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Images\frog.jpg">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Images\honeybadger.jpg">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Images\kangaroo.jpg">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Images\Lions_migration.jpg" />
    <Resource Include="Images\Monkyes_jump.JPG" />
    <Resource Include="Images\penguin_jump.JPG" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

</Project>
